+  void logUlcLimits()
+  {
+    RCLCPP_INFO(get_logger(),
+                "ULC limits: accel=%.2f m/ss, decel=%.2f m/ss, "
+                "jerk_throttle=%.2f m/sss, jerk_brake=%.2f m/sss, coast_decel=%s, "
